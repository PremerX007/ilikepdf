function(CONFIGURE_QPDF_RUNTIME QPDF_SOURCE_ROOT)
  set(QPDF_MANIFEST "${QPDF_SOURCE_ROOT}/runtime-manifest.txt")
  set(QPDF_DISTRIBUTION "${QPDF_SOURCE_ROOT}/windows/x64")
  if(NOT EXISTS "${QPDF_MANIFEST}")
    message(FATAL_ERROR "Pinned qpdf runtime manifest is missing: ${QPDF_MANIFEST}")
  endif()

  file(STRINGS "${QPDF_MANIFEST}" QPDF_MANIFEST_LINES)
  set(QPDF_HAS_VERSION FALSE)
  set(QPDF_HAS_TARGET FALSE)
  set(QPDF_HAS_ARCHITECTURE FALSE)
  set(QPDF_HAS_ARTIFACT_CHECKSUM FALSE)
  set(QPDF_HAS_EXECUTABLE FALSE)
  set(QPDF_RUNTIME_FILES "")
  set(QPDF_LICENSE_FILES "")
  set(QPDF_PROVENANCE_FILES "")

  foreach(QPDF_LINE IN LISTS QPDF_MANIFEST_LINES)
    if(QPDF_LINE MATCHES "^version=.+$")
      set(QPDF_HAS_VERSION TRUE)
    elseif(QPDF_LINE STREQUAL "target=windows")
      set(QPDF_HAS_TARGET TRUE)
    elseif(QPDF_LINE STREQUAL "architecture=x86_64")
      set(QPDF_HAS_ARCHITECTURE TRUE)
    elseif(QPDF_LINE MATCHES "^artifact_sha256=[0-9a-fA-F]+$")
      string(REGEX REPLACE "^artifact_sha256=" "" QPDF_ARTIFACT_SHA256 "${QPDF_LINE}")
      string(LENGTH "${QPDF_ARTIFACT_SHA256}" QPDF_ARTIFACT_SHA256_LENGTH)
      if(QPDF_ARTIFACT_SHA256_LENGTH EQUAL 64)
        set(QPDF_HAS_ARTIFACT_CHECKSUM TRUE)
      endif()
    elseif(QPDF_LINE STREQUAL "executable=bin/qpdf.exe")
      set(QPDF_HAS_EXECUTABLE TRUE)
    elseif(QPDF_LINE MATCHES "^runtime_file=([^|]+)\\|([0-9a-fA-F]+)$")
      set(QPDF_RELATIVE_PATH "${CMAKE_MATCH_1}")
      set(QPDF_EXPECTED_SHA256 "${CMAKE_MATCH_2}")
      set(QPDF_FILE "${QPDF_DISTRIBUTION}/${QPDF_RELATIVE_PATH}")
      _VERIFY_QPDF_FILE("${QPDF_FILE}" "${QPDF_EXPECTED_SHA256}")
      list(APPEND QPDF_RUNTIME_FILES "${QPDF_FILE}")
    elseif(QPDF_LINE MATCHES "^package_file=([^|]+)\\|([0-9a-fA-F]+)$")
      set(QPDF_RELATIVE_PATH "${CMAKE_MATCH_1}")
      set(QPDF_EXPECTED_SHA256 "${CMAKE_MATCH_2}")
      set(QPDF_FILE "${QPDF_DISTRIBUTION}/${QPDF_RELATIVE_PATH}")
      _VERIFY_QPDF_FILE("${QPDF_FILE}" "${QPDF_EXPECTED_SHA256}")
      list(APPEND QPDF_LICENSE_FILES "${QPDF_FILE}")
    elseif(QPDF_LINE MATCHES "^provenance_file=([^|]+)\\|([0-9a-fA-F]+)$")
      set(QPDF_RELATIVE_PATH "${CMAKE_MATCH_1}")
      set(QPDF_EXPECTED_SHA256 "${CMAKE_MATCH_2}")
      set(QPDF_FILE "${QPDF_SOURCE_ROOT}/${QPDF_RELATIVE_PATH}")
      _VERIFY_QPDF_FILE("${QPDF_FILE}" "${QPDF_EXPECTED_SHA256}")
      list(APPEND QPDF_PROVENANCE_FILES "${QPDF_FILE}")
    endif()
  endforeach()

  if(NOT QPDF_HAS_VERSION OR NOT QPDF_HAS_TARGET OR NOT QPDF_HAS_ARCHITECTURE
      OR NOT QPDF_HAS_ARTIFACT_CHECKSUM OR NOT QPDF_HAS_EXECUTABLE
      OR NOT QPDF_RUNTIME_FILES OR NOT QPDF_LICENSE_FILES
      OR NOT QPDF_PROVENANCE_FILES)
    message(FATAL_ERROR "Pinned qpdf runtime manifest is incomplete or targets an unsupported package")
  endif()

  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${QPDF_MANIFEST}" ${QPDF_RUNTIME_FILES} ${QPDF_LICENSE_FILES}
    ${QPDF_PROVENANCE_FILES})
  set(QPDF_RUNTIME_FILES "${QPDF_RUNTIME_FILES}" PARENT_SCOPE)
  set(QPDF_LICENSE_FILES "${QPDF_LICENSE_FILES}" PARENT_SCOPE)
  set(QPDF_PROVENANCE_FILES "${QPDF_PROVENANCE_FILES}" PARENT_SCOPE)
  set(QPDF_RUNTIME_MANIFEST "${QPDF_MANIFEST}" PARENT_SCOPE)
  set(QPDF_RUNTIME_README "${QPDF_SOURCE_ROOT}/README.md" PARENT_SCOPE)
endfunction()

function(_VERIFY_QPDF_FILE FILE_PATH EXPECTED_SHA256)
  if(NOT EXISTS "${FILE_PATH}")
    message(FATAL_ERROR "Pinned qpdf component is missing: ${FILE_PATH}")
  endif()
  string(LENGTH "${EXPECTED_SHA256}" QPDF_EXPECTED_SHA256_LENGTH)
  if(NOT QPDF_EXPECTED_SHA256_LENGTH EQUAL 64)
    message(FATAL_ERROR "Pinned qpdf checksum is invalid for: ${FILE_PATH}")
  endif()
  file(SHA256 "${FILE_PATH}" QPDF_ACTUAL_SHA256)
  string(TOLOWER "${EXPECTED_SHA256}" QPDF_EXPECTED_SHA256_LOWER)
  if(NOT QPDF_ACTUAL_SHA256 STREQUAL QPDF_EXPECTED_SHA256_LOWER)
    message(FATAL_ERROR
      "Pinned qpdf checksum mismatch for ${FILE_PATH}: expected ${QPDF_EXPECTED_SHA256_LOWER}, got ${QPDF_ACTUAL_SHA256}")
  endif()
endfunction()
